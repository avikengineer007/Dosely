# Dosely Environment Configuration Example
# Copy to .env and provide strong, unique secrets (>= 32 characters each)

# Environment mode: 'development' or 'production'
ENV=development

# Symmetric key for encrypting prescription images at rest (min 32 bytes)
IMAGE_ENCRYPTION_KEY=replace-with-secure-32-byte-random-string-for-image-encryption

# Comma-separated list of secondary/legacy keys for MultiFernet rotation
IMAGE_ENCRYPTION_KEYS=

# Secret key for JWT access tokens (min 32 bytes)
JWT_SECRET_KEY=replace-with-secure-32-byte-random-string-for-jwt-signing

# Anthropic Claude API Key for prescription extraction
ANTHROPIC_API_KEY=

# Trusted reverse proxies for client IP rate limiting (comma-separated)
TRUSTED_PROXIES=127.0.0.1,::1,localhost

# Purge settings (data retention in days and run interval in hours)
PURGE_DAYS=30
PURGE_INTERVAL_HOURS=24
