{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "main.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/main.py?__vc_path=/"
    },
    {
      "source": "/((?!main\\.py$).*)",
      "destination": "/main.py?__vc_path=/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/purge",
      "schedule": "0 0 * * *"
    }
  ]
}
