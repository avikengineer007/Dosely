{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index?__vc_path=/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/purge",
      "schedule": "0 0 * * *"
    }
  ]
}
