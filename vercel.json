{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "main.py": {
      "includeFiles": "{dosely.html,frontend/**,data/**,static/**}",
      "maxDuration": 60
    },
    "api/*.py": {
      "includeFiles": "{dosely.html,frontend/**,data/**,static/**}",
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/purge",
      "schedule": "0 0 * * *"
    }
  ]
}
