{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "main.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/main.py?__vc_path=/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/purge",
      "schedule": "0 0 * * *"
    }
  ]
}
